{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "三维模型查看器",
  "version": "0.1.0",
  "identifier": "com.shinezer0.modelviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "三维模型查看器",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["glb", "gltf", "stl", "fbx", "obj", "ply", "3mf"],
        "name": "三维模型文件",
        "description": "三维模型（glTF / FBX / OBJ / STL / PLY / 3MF）",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
